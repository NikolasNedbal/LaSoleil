  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hr\xE1\u010D m\xE1 k dispozici skl\xE1d pro ulo\u017Een\xED moment\xE1ln\u011B
    nepot\u0159ebn\xFDch v\u011Bci:\nOtev\xEDr\xE1 se a zav\xEDr\xE1 se tla\u010D\xEDtkem
    pro interakci.\n\nHr\xE1\u010D tak\xE9 m\u016F\u017Ee zasadit k\xE1vovou rostlinu,
    kter\xE1 n\xE1sledn\u011B roste po 7 dn\xED a pak lze sklidit.\nZde lze zasadit:             
    Takto vypad\xE1 vyrostl\xE1 rostlina:\n\n\nVyrostl\xE9 a sklizen\xE9 rostliny
    m\u016F\u017Ee hr\xE1\u010D zpracovat v tomto za\u0159\xEDzen\xED:\nDo slotu
    se vlo\u017E\xED rostlina, zm\xE1\u010Dkne se tla\u010D\xEDtko a po jednom dni\nse
    v p\u0159\xEDstroji p\u0159ed\u011Bl\xE1 rostlina na po\u017Eadovan\xE9 \"Coffee
    Beans\"\n\nA kdyby si hr\xE1\u010D cht\u011Bl zp\u0159\xEDjemnit atmosf\xE9ru..
    m\u016F\u017Ee si pustit gramofon, ov\u0161em je za pot\u0159eb\xED v invent\xE1\u0159i
    m\xEDt n\u011Bjakou desku.\n\n\nHr\xE1\u010D m\u016F\u017Ee p\u0159esko\u010Dit
    den span\xEDm, postel je v druh\xE9m pat\u0159e.\n\n!! Itemy/P\u0159edm\u011Bty
    hr\xE1\u010D m\u016F\u017Ee p\u0159esouvat prav\xFDm kliknut\xEDm na p\u0159edm\u011Bt,
    kter\xFD\nchce p\u0159esunout a druh\xFDm prav\xFDm kliknut\xEDm, kam ho chce
    p\u0159esunout. !!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
