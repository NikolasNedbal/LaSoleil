--- !u!114 &1513655819
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1513655817}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Pohyb = \"W S A D\"   kl\xE1vesa pro interakci = \"F\"   s\xE1zen\xED
    rostlin = \"P\"   sklize\u0148 rostlin = \"H\"\n\nHlavn\xED c\xEDl t\xE9to hry
    je udr\u017Eet kav\xE1rnu v provozu co nejd\xE9le! Na za\u010D\xE1tku ka\u017Ed\xE9ho
    t\xFDdne hr\xE1\u010D mus\xED zaplatit n\xE1jem, kter\xFD se postupn\u011B zvy\u0161uje.
    Hranice kolik m\u016F\u017Ee hr\xE1\u010D j\xEDt do m\xEDnusu je 150, kdy\u017E
    p\u016Fjde hr\xE1\u010D p\u0159es 150 do m\xEDnusu, hra se vypne.\n\nAby hr\xE1\u010Di
    do kav\xE1rny p\u0159ich\xE1zeli z\xE1kazn\xEDci, mus\xED zm\xE1\u010Dknout tla\u010D\xEDtko
    \"Open\" a pro zav\u0159en\xED kav\xE1rny zm\xE1\u010Dknout to sam\xE9 tla\u010D\xEDtko,
    ov\u0161em tentokr\xE1t s textem \"Close\".\nPot\xE9 co z\xE1kazn\xEDk p\u0159ijde
    do kav\xE1rny, bude m\xEDt nam\xED\u0159eno k pokladn\u011B, kde hr\xE1\u010D
    p\u0159ijme objedn\xE1vku tla\u010D\xEDtkem interakce, n\xE1sledn\u011B si jde
    z\xE1kazn\xEDk sednout ke stolu a za\u010D\xEDn\xE1 odpo\u010Det, do kdy mu hr\xE1\u010D
    mus\xED p\u0159in\xE9st kafe, kter\xE9 mu hr\xE1\u010D d\xE1 hl. tla\u010D\xEDtkem
    interakce. Kav\xE1rna lze otev\u0159\xEDt v \u010Dase od 6 hodin do 22 hodin.\n\nKafe
    se d\u011Bl\xE1 zde:               hr\xE1\u010D mus\xED m\xEDt v invent\xE1\u0159i
    \"Coffee Beans\", pro zp\u0159\xEDstupn\u011Bn\xED.\n\nCukr a ml\xE9ko jde z\xEDskat
    jen v obchod\u011B.\n\nPro cestov\xE1n\xED hr\xE1\u010D mus\xED p\u0159ij\xEDt
    ke dve\u0159\xEDm od kav\xE1rny a stisknout\ntla\u010D\xEDtko pro interakci.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
